# Copia este archivo como .env (o define las variables en tu plataforma de deploy).
DEBUG=true
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# Origen público del frontend. Agrega también el de la API para poder usar /admin/.
CSRF_TRUSTED_ORIGINS=http://localhost:3000
