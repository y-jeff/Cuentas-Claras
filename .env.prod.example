# Copia este archivo como .env junto a docker-compose.prod.yml. Nunca lo subas a git.
# Genera el valor con: openssl rand -hex 32
SECRET_KEY=

# Dominios públicos (sin https://).
WEB_DOMAIN=cuentasclaras.3rlabs.cl
API_DOMAIN=api-cuentasclaras.3rlabs.cl

# Puerto local de la API (solo 127.0.0.1). Cámbialo si choca con otra app del servidor.
API_PORT=8000
