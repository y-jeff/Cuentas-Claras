# Copia este archivo como .env junto a docker-compose.prod.yml. Nunca lo subas a git.
# Genera cada valor con: openssl rand -hex 32  (hex: sin caracteres que rompan la URL de Postgres)
SECRET_KEY=
POSTGRES_PASSWORD=

# Dominios públicos (sin https://).
WEB_DOMAIN=cuentasclaras.3rlabs.cl
API_DOMAIN=api.cuentasclaras.3rlabs.cl

# Puertos locales (solo 127.0.0.1). Cámbialos si chocan con otra app del servidor.
WEB_PORT=3000
API_PORT=8000
